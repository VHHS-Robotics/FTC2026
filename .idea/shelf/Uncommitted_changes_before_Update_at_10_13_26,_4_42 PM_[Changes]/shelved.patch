+                    follower.followPath(paths.SecondLine,0.2, true);
+                    myPathstates = pathStates.pathState4;
+                }
+                break;
+            case pathState4:
+                if (!follower.isBusy()) {
+                    follower.followPath(paths.ThirdLine,0.2, true);
+                    myPathstates = pathStates.pathState5;
+                }
+                break;
+            case pathState5:
+                if (!follower.isBusy()) {
