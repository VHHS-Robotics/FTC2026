+            position = localizer.pose();
+        }
+
+        if (position == null) {
+            return null;
+        }
+        double movement = pod.equals("Strafe") ? position.y() : position.x();
+        if (movement == 0.0) {
+            return null;
+        }
+        return List.of(Math.abs(movement / distance), movement < 0 ? Encoder.REVERSE : Encoder.FORWARD);
+    }
+}
